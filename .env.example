# Meetbowl local infra example values.
# Copy to .env for local development. Do not commit real secrets.

# MariaDB: accessed only by meetbowl-be.
MARIADB_PORT=3306
MARIADB_ROOT_PASSWORD=local-root-password
MARIADB_DATABASE=meetbowl
MARIADB_USER=meetbowl
MARIADB_PASSWORD=local-meetbowl-password

# Redis: cache and Redis Stream runtime. Do not use as long-term storage.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# RabbitMQ: durable async jobs and DLQ.
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=meetbowl
RABBITMQ_DEFAULT_PASS=local-rabbitmq-password
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_URL=amqp://meetbowl:local-rabbitmq-password@localhost:5672/

# LiveKit: meetbowl-be should issue user join tokens.
LIVEKIT_HTTP_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882
LIVEKIT_PUBLIC_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=local-livekit-secret-change-me-123456
# Host-run clients can use 127.0.0.1. For the STT Compose profile, set a LAN IP
# reachable from both the host browser and Docker containers.
LIVEKIT_NODE_IP=127.0.0.1

# Optional meetbowl-stt Compose profile.
# OPENAI_API_KEY must be supplied only at runtime and must never be committed.
STT_PORT=3000
STT_INTERNAL_TOKEN=local-internal-token-change-me
OPENAI_API_KEY=
OPENAI_REALTIME_TRANSLATION_MODEL=gpt-realtime-translate
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-realtime-whisper
OPENAI_REALTIME_TRANSCRIPTION_DELAY=low
ENABLE_TRANSLATION=false
LIVEKIT_AGENT_IDENTITY_PREFIX=meetbowl-stt
# Keep the service URL for signaling. RTC candidates use LIVEKIT_NODE_IP.
STT_LIVEKIT_URL=http://livekit:7880
RABBITMQ_EXCHANGE=meetbowl.topic
REDIS_FEEDBACK_CONSUMER_GROUP=stt-feedback-relay
REDIS_FEEDBACK_CONSUMER_NAME=stt-local
REDIS_STREAM_MAX_LENGTH=2000
VAD_RMS_THRESHOLD=0.015
VAD_SILENCE_MS=700
SEGMENT_NO_DELTA_TIMEOUT_MS=1200
TRANSLATION_GRACE_MS=500
MAX_SEGMENT_DURATION_MS=15000

# Qdrant: accessed by meetbowl-ai.
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333

# Elasticsearch: user/member search index for meetbowl-be.
ELASTICSEARCH_HTTP_PORT=9200
MEETBOWL_ELASTICSEARCH_URL=http://localhost:9200
MEETBOWL_USER_SEARCH_INDEX=meetbowl-users

# External S3 compatible object storage.
# Infra does not run MinIO. File permission checks belong to meetbowl-be.
AWS_REGION=ap-northeast-2
S3_BUCKET=meetbowl-local-example
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=example-access-key
AWS_SECRET_ACCESS_KEY=example-secret-key
